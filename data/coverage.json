{
 "version": 1,
 "release": 8,
 "blocks": [
  {
   "id": "production",
   "label": "Production",
   "text": "A production table with at least one row."
  },
  {
   "id": "reserves",
   "label": "Reserves",
   "text": "A reserves table with at least one row."
  },
  {
   "id": "consumption",
   "label": "Consumption",
   "text": "A consumption table with at least one row."
  },
  {
   "id": "trade",
   "label": "Trade",
   "text": "An exports table and an imports table, each with at least one row."
  },
  {
   "id": "lanes",
   "label": "Lanes",
   "text": "At least one sea lane."
  },
  {
   "id": "routes",
   "label": "Routes",
   "text": "At least one route that carries the commodity. It counts the Atlas corridors generated from customs pairs as well as the benchmark routes and the routes written by hand."
  },
  {
   "id": "price",
   "label": "Price",
   "text": "At least one price series."
  },
  {
   "id": "assets",
   "label": "Assets",
   "text": "At least one infrastructure asset."
  },
  {
   "id": "companies",
   "label": "Companies",
   "text": "At least one company entry."
  },
  {
   "id": "monthly",
   "label": "Monthly",
   "text": "A monthly series.",
   "families": [
    "energy"
   ]
  },
  {
   "id": "balance",
   "label": "Balance",
   "text": "A balance of stocks and use, with at least one row.",
   "families": [
    "softs"
   ]
  }
 ],
 "reasons": {
  "reserves-agricultural": {
   "st": "na",
   "t": "Reserves count what lies in the ground. This is grown and harvested again, so none is counted."
  },
  "reserves-refined": {
   "st": "na",
   "t": "Reserves are counted for crude oil and natural gas, not for what is refined, separated or liquefied from them."
  },
  "reserves-made-from-ore": {
   "st": "na",
   "t": "Reserves are counted for the ore in the ground, not for the metal or the alloy made from it."
  },
  "reserves-scrap": {
   "st": "na",
   "t": "Scrap is recovered from used metal, not mined: there is no deposit to count."
  },
  "reserves-urea": {
   "st": "na",
   "t": "Urea is made in plants from ammonia: no deposit is counted for it."
  },
  "reserves-compound-fertiliser": {
   "st": "na",
   "t": "A compound fertiliser is made in plants: reserves are counted for phosphate rock and potash, on their own pages."
  },
  "lanes-by-air": {
   "st": "na",
   "t": "These metals move mostly by air, so the atlas draws no sea lanes for them."
  },
  "lanes-gas": {
   "st": "na",
   "t": "Gas is traded by pipeline, or by sea as LNG: the sea lanes are on the LNG page."
  },
  "routes-no-lanes": {
   "st": "na",
   "t": "No sea lanes are drawn for it, so there is no sea route."
  },
  "balance-fertiliser": {
   "st": "na",
   "t": "The balance of stocks and use is a table of crops; a fertiliser is not a crop."
  }
 },
